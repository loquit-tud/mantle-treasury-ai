# Quorum Frontend Configuration

# API URL (backend server)
VITE_API_URL=http://localhost:3001

# WebSocket URL (usually same as API)
VITE_WS_URL=ws://localhost:3001/ws

# Chain Configuration (Mantle Network)
VITE_CHAIN_ID=5000
VITE_CHAIN_NAME=Mantle

# Optional: Block Explorer
VITE_EXPLORER_URL=https://explorer.mantle.xyz
