# AgentTreasury Backend Configuration

# OpenAI-compatible API Key (required — works with OpenAI, Groq, etc.)
OPENAI_API_KEY=sk-your-api-key-or-gsk_groq-key

# LLM Model (default: gpt-4 for OpenAI, llama-3.3-70b-versatile for Groq)
LLM_MODEL=llama-3.3-70b-versatile

# LLM Base URL (optional — set for Groq or other OpenAI-compatible providers)
# Groq: https://api.groq.com/openai/v1
# OpenAI: leave empty (default)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Fallback LLM (optional — auto-switches on 429 / rate limit)
# Example: use OpenAI as fallback when Groq hits rate limits
# LLM_FALLBACK_API_KEY=sk-your-openai-key
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_NAME=openai

# Agent Wallet Seed Phrase (required - 12 words)
AGENT_SEED_PHRASE=your twelve word seed phrase here do not reuse

# Blockchain Configuration
RPC_URL=<your-rpc-url>
CHAIN_ID=<chain-id>

# Contract Addresses (deploy with: npm run contracts:deploy)
USDT_ADDRESS=<usdt-address>
TREASURY_VAULT_ADDRESS=<deployed>
CREDIT_LINE_ADDRESS=<deployed>

# DeFi Protocol Addresses
AAVE_POOL_ADDRESS=<aave-or-equivalent-pool-address>

# Server Configuration
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# API Secret — set this to a random secret to protect mutation endpoints (POST/DELETE)
# Leave empty to skip auth (dev mode). Required in production.
# API_SECRET=your-random-secret-here

# Telegram Bot (optional — human-in-the-loop for large transactions)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
