# Quorum Backend Configuration

# OpenAI-compatible API Key (required — works with OpenAI, Groq, etc.)
OPENAI_API_KEY=sk-your-api-key-or-gsk_groq-key

# LLM Model (default: gpt-4 for OpenAI, llama-3.3-70b-versatile for Groq)
LLM_MODEL=llama-3.3-70b-versatile

# LLM Base URL (optional — set for Groq or other OpenAI-compatible providers)
# Groq: https://api.groq.com/openai/v1
# OpenAI: leave empty (default)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Fallback LLM (optional — auto-switches on 429 / rate limit)
# Example: use OpenAI as fallback when Groq hits rate limits
# LLM_FALLBACK_API_KEY=sk-your-openai-key
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_NAME=openai

# Agent Wallet Seed Phrase (required - 12 words)
AGENT_SEED_PHRASE=your twelve word seed phrase here do not reuse

# Blockchain Configuration (Mantle Network)
# Mainnet: RPC_URL=https://rpc.mantle.xyz, CHAIN_ID=5000
# Testnet: RPC_URL=https://rpc.sepolia.mantle.xyz, CHAIN_ID=5003
RPC_URL=https://rpc.mantle.xyz
CHAIN_ID=5000

# Contract Addresses — Mantle Mainnet (5000)
# Deployed: 2026-05-03
USDT_ADDRESS=0xD647502C2AF782c8963C827ae556d70d9b387493
TREASURY_VAULT_ADDRESS=0xEadD4D9060531717056F660352d7564e04dA521c
CREDIT_LINE_ADDRESS=0xDfC66a9384d688B4B433a73444768bc36064928d

# Mantle Native RWA Tokens
USDY_ADDRESS=0x5bE26527e817998A7206475496fDE1E68957c5A6
METH_ADDRESS=0xcDA86A272531e8640cd7F1a92c01839911b90bb0
USDC_ADDRESS=0x09Bc4E0D864854c6aFB6eb9A9cdF58aC190D0dF9
USDT_NATIVE_ADDRESS=0x201EBa5CC46D216Ce6DC03F6a759e8E766e956aE

# --- Testnet (Mantle Sepolia 5003) ---
# MockUSDT:     0xDeB860E9D81461aefa8FAdaF61C58d76A9EE0412
# TreasuryVault: 0xac8Fd2268411C46Eb82a70D25D7De2d8B4c1d685
# CreditLine:   0x368f8Ef13df7e0169a8dbcC94b30B01C37c755aC

# DeFi Protocol Addresses
# Aurelius Finance (Aave V3 fork on Mantle): https://aurelius.finance
# Pool proxy: check https://docs.aurelius.finance for current address
AAVE_POOL_ADDRESS=<aurelius-or-lendle-pool-address>

# Server Configuration
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# API Secret — set this to a random secret to protect mutation endpoints (POST/DELETE)
# Leave empty to skip auth (dev mode). Required in production.
# API_SECRET=your-random-secret-here

# Telegram Bot (optional — human-in-the-loop for large transactions)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
